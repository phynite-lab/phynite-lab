{
  "productName": "Phynite Lab",
  "identifier": "com.phynitelab.desktop",
  "build": { "frontendDist": "startup" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": { "payload/": "payload/" },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
