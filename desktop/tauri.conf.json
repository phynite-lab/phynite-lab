{
  "productName": "Phynite Lab",
  "identifier": "com.phynitelab.desktop",
  "app": {
    "windows": [],
    "security": {
      "capabilities": [{
        "identifier": "workspace-native-controls",
        "local": false,
        "remote": { "urls": ["http://127.0.0.1:47739/*"] },
        "webviews": ["workspace-view"],
        "permissions": ["allow-update-project-tabs", "allow-update-appearance", "allow-open-settings"]
      }]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": { "payload/": "payload/" },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
