{
  "name": "phynite-lab",
  "version": "0.1.30",
  "description": "Phynite Lab local computational materials-science workspace",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phynite-lab/phynite-lab.git"
  },
  "homepage": "https://github.com/phynite-lab/phynite-lab#readme",
  "bugs": {
    "url": "https://github.com/phynite-lab/phynite-lab/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "phynite-lab": "bin/phynite-lab.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "distribution.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "optionalDependencies": {
    "phynite-lab-runtime-darwin-arm64": "0.1.30",
    "phynite-lab-runtime-linux-arm64": "0.1.30",
    "phynite-lab-runtime-linux-x64": "0.1.30"
  },
  "scripts": {
    "prepack": "node lib/check-distribution.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
